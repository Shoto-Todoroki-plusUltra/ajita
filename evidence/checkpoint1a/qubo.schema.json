{
  "$defs": {
    "DecodeMap": {
      "additionalProperties": false,
      "properties": {
        "active_indices": {
          "items": {
            "type": "integer"
          },
          "title": "Active Indices",
          "type": "array"
        },
        "auxiliary_variables": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 0,
          "title": "Auxiliary Variables",
          "type": "array"
        },
        "city_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 4,
          "title": "City Ids",
          "type": "array"
        },
        "depot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Depot Id",
          "type": "string"
        },
        "fixed_variables": {
          "items": {
            "$ref": "#/$defs/FixedVariable"
          },
          "title": "Fixed Variables",
          "type": "array"
        }
      },
      "required": [
        "city_ids",
        "depot_id",
        "active_indices",
        "fixed_variables",
        "auxiliary_variables"
      ],
      "title": "DecodeMap",
      "type": "object"
    },
    "DomainRef": {
      "additionalProperties": false,
      "properties": {
        "city_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "City Id",
          "type": "string"
        },
        "position": {
          "maximum": 7,
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        }
      },
      "required": [
        "city_id",
        "position"
      ],
      "title": "DomainRef",
      "type": "object"
    },
    "FixedVariable": {
      "additionalProperties": false,
      "properties": {
        "domain_ref": {
          "$ref": "#/$defs/DomainRef"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "domain_ref",
        "value"
      ],
      "title": "FixedVariable",
      "type": "object"
    },
    "Penalty": {
      "additionalProperties": false,
      "properties": {
        "adequacy_status": {
          "enum": [
            "sufficient_bound",
            "unproven_experiment"
          ],
          "title": "Adequacy Status",
          "type": "string"
        },
        "bound_basis": {
          "const": "A > n*d_max; nonnegative cost and integer residuals",
          "title": "Bound Basis",
          "type": "string"
        },
        "constraint_family": {
          "enum": [
            "one_city_per_position",
            "one_position_per_city"
          ],
          "title": "Constraint Family",
          "type": "string"
        },
        "feasible_cost_upper_bound": {
          "minimum": 0,
          "title": "Feasible Cost Upper Bound",
          "type": "number"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "constraint_family",
        "weight",
        "adequacy_status",
        "bound_basis",
        "feasible_cost_upper_bound"
      ],
      "title": "Penalty",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "converter_sequence": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Converter Sequence",
          "type": "array"
        },
        "implementation": {
          "const": "quantum_workload_studio.explicit_tsp",
          "title": "Implementation",
          "type": "string"
        },
        "version": {
          "const": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "implementation",
        "version",
        "converter_sequence"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        },
        "i": {
          "maximum": 48,
          "minimum": 0,
          "title": "I",
          "type": "integer"
        },
        "j": {
          "maximum": 48,
          "minimum": 0,
          "title": "J",
          "type": "integer"
        }
      },
      "required": [
        "i",
        "j",
        "coefficient"
      ],
      "title": "Term",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "domain_ref": {
          "$ref": "#/$defs/DomainRef"
        },
        "index": {
          "maximum": 48,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "index",
        "name",
        "domain_ref"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "convention": {
      "const": "upper_triangular",
      "title": "Convention",
      "type": "string"
    },
    "decode_map": {
      "$ref": "#/$defs/DecodeMap"
    },
    "encoding_id": {
      "const": "tsp_position_depot_fixed",
      "title": "Encoding Id",
      "type": "string"
    },
    "encoding_version": {
      "const": 1,
      "title": "Encoding Version",
      "type": "integer"
    },
    "energy_unit": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Energy Unit",
      "type": "string"
    },
    "offset": {
      "title": "Offset",
      "type": "number"
    },
    "penalties": {
      "items": {
        "$ref": "#/$defs/Penalty"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Penalties",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scale": {
      "exclusiveMinimum": 0,
      "title": "Scale",
      "type": "number"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sense": {
      "const": "minimize",
      "title": "Sense",
      "type": "string"
    },
    "source_instance_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Instance Hash",
      "type": "string"
    },
    "terms": {
      "items": {
        "$ref": "#/$defs/Term"
      },
      "maxItems": 1225,
      "title": "Terms",
      "type": "array"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "maxItems": 49,
      "minItems": 9,
      "title": "Variables",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "convention",
    "sense",
    "variables",
    "terms",
    "offset",
    "energy_unit",
    "scale",
    "source_instance_hash",
    "encoding_id",
    "encoding_version",
    "penalties",
    "decode_map",
    "provenance"
  ],
  "title": "QuboArtifact",
  "type": "object"
}
